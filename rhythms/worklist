#!/bin/sh
# worklist — 愛FM follows the shift: rebuild the soundtrack from the Bench.
# Scheduled by the human (launchd LaunchAgent / cron); by hand: sh rhythms/worklist
# Off-switch: touch rhythms/STILL   (every beat rests until it is removed)
#
# Copies room 7's shape whole and obeys all five laws:
#   1. off-switch first   2. one-at-a-time lock   3. idle costs nothing
#   4. hard ceiling on the real work   5. a log, listed on the bench as weather

# 1. THE HAND-BRAKE — literally first, before we even resolve ROOT. STILL sits
#    beside this script (rhythms/STILL) — exactly what the human is told to
#    touch — so no WORKLIST_HOME override, cwd, or symlink can move the brake
#    out from under it. This check is resolution-independent by construction.
[ -e "$(dirname "$0")/STILL" ] && exit 0

# Resolve the room root (override with WORKLIST_HOME).
ROOT="${WORKLIST_HOME:-$(cd "$(dirname "$0")/.." && pwd)}"

# 1b. Also honor a STILL under the resolved root's rhythms dir (belt & braces:
#     if WORKLIST_HOME is set, a STILL there rests it too).
[ -e "$ROOT/rhythms/STILL" ] && exit 0

# 2. ONE AT A TIME — a lock dir; the trap clears it on any exit.
LOCKDIR="$ROOT/rhythms/.lock"
mkdir "$LOCKDIR" 2>/dev/null || exit 0
trap 'rmdir "$LOCKDIR" 2>/dev/null' EXIT INT TERM

# Locate the bench the same way the CLI does: $HOME/BENCH.md, then ./BENCH.md.
BENCH="${BENCH_MD:-$HOME/BENCH.md}"
[ -f "$BENCH" ] || BENCH="$ROOT/BENCH.md"

STAMP="$ROOT/rhythms/.bench-stamp"
LOG="$ROOT/rhythms/worklist.log"

# 3. IDLE COSTS NOTHING — has the bench changed since the last beat? A cksum
#    of the file is cheap and portable; no change → rest without paying.
if [ -f "$BENCH" ]; then
  SIG=$(cksum < "$BENCH")
else
  SIG="no-bench"
fi
if [ -f "$STAMP" ] && [ "$(cat "$STAMP")" = "$SIG" ]; then
  exit 0
fi

# 4. THE REAL WORK, UNDER A HARD CEILING — rebuild session + player from the
#    current bench. --from-bench fails silent if the bench holds nothing fresh.
#    The alarm caps a stuck beat at 120s so it can never linger past its slot.
{
  echo "── $(date '+%Y-%m-%d %H:%M:%S') · bench changed → rebuild ($BENCH) ──"
  perl -e 'alarm shift; exec @ARGV' 120 node "$ROOT/bin/worklist" --from-bench "$BENCH"
  echo "── beat done (exit $?) ──"
} >> "$LOG" 2>&1

# 5. Remember what we just processed, so an unchanged bench stays idle.
echo "$SIG" > "$STAMP"
